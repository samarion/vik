; From cvc5: regress0/uflra/simple.03.cvc.smt2 (modified BSD, LICENSES/cvc5.txt)
; EXPECT: sat
; logic: QF_UFLRA, the smallest the script fits, for ALL (prune logic)
(set-logic QF_UFLRA)
(set-option :incremental false)
(declare-fun x1 () Real)
(declare-fun y1 () Real)
(declare-fun z1 () Real)
(declare-fun x2 () Real)
(declare-fun y2 () Real)
(declare-fun z2 () Real)
(declare-fun f (Real) Real)
(declare-fun g (Real Real) Real)
(assert (= z1 (f x1)))
(assert (= z2 (f y1)))
(assert (not (= (g z1 z2) (g z2 y2))))
(set-info :status sat)
(check-sat)
