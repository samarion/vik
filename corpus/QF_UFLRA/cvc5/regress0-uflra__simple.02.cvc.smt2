; From cvc5: regress0/uflra/simple.02.cvc.smt2 (modified BSD, LICENSES/cvc5.txt)
; EXPECT: unsat
; logic: QF_UFLRA, the smallest the script fits, for ALL (prune logic)
(set-logic QF_UFLRA)
(set-option :incremental false)
(declare-fun x () Real)
(declare-fun y () Real)
(declare-fun f (Real) Real)
(assert (<= x y))
(assert (<= y x))
(assert (not (= (f x) (f y))))
(set-info :status unsat)
(check-sat)
