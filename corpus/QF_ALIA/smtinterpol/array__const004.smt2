; From smtinterpol: array/const004.smt2 (LGPL-3.0, LICENSES/smtinterpol.txt)
; statuses: the `unknown` ones answered by Z3 version 4.15.1 (statusstamp, 2026-11-18; its `set-option` and `get-` commands left out, z3 refusing SMTInterpol's options)
(set-option :produce-proofs true)
(set-option :proof-check-mode true)
(set-option :print-terms-cse false)

(set-logic QF_ALIA)
(declare-sort U 0)
(declare-fun v () U)
(declare-fun i () Int)
(declare-fun w () U)
(declare-fun a () (Array Int U))

(assert (= (store a i w) ((as const (Array Int U)) v)))
(assert (= (select a i) v))
(assert (not (= a ((as const (Array Int U)) v))))
(set-info :status unsat)
(check-sat)
(get-proof)
(exit)