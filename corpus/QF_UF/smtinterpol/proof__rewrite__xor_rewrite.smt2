(set-option :produce-proofs true)
(set-option :proof-check-mode true)
(set-option :model-check-mode true)
(set-option :print-terms-cse false)

(set-logic QF_UF)
(declare-fun p () Bool)
(declare-fun q () Bool)
(declare-fun r () Bool)

(push 1)
(assert (xor p q r))
(assert q)
(assert (xor p r))
(set-info :status unsat)
(check-sat)
(get-proof)
(pop 1)


(push 1)
(assert (xor p q r false))
(assert q)
(assert (xor p r))
(set-info :status unsat)
(check-sat)
(get-proof)
(pop 1)

(push 1)
(assert (xor p q r true))
(assert q)
(assert (not (xor p r)))
(set-info :status unsat)
(check-sat)
(get-proof)
(pop 1)

(push 1)
(assert (xor p p))
(set-info :status unsat)
(check-sat)
(get-proof)
(pop 1)

(push 1)
(assert (xor (xor p (not p)) p))
(assert p)
(set-info :status unsat)
(check-sat)
(get-proof)
(pop 1)
