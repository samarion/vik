; From smtinterpol: proof/rewrite/xor_notnot.smt2 (LGPL-3.0, LICENSES/smtinterpol.txt)
; logic: QF_UF, the smallest the script fits, for CORE (prune logic)
; statuses: the `unknown` ones answered by Z3 version 4.14.0 (statusstamp, 2026-11-17; its `set-option` and `get-` commands left out, z3 refusing SMTInterpol's options)
(set-option :produce-interpolants true)
(set-option :simplify-interpolants true)
(set-option :produce-proofs true)
(set-option :proof-check-mode true)
(set-logic QF_UF)
(declare-fun v0 () Bool)
(declare-fun v1 () Bool)
(assert (not (= (xor (not (not v0)) (not (not (not v1)))) (xor v0 (not v1)))))
(set-info :status unsat)
(check-sat)
(get-proof)
