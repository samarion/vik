; From cvc5: regress0/unconstrained/issue4656-bool-term-vars.smt2 (modified BSD, LICENSES/cvc5.txt)
; logic: QF_UF, the smallest the script fits, for QF_AUFBVLIA (prune logic)
(set-logic QF_UF)
(set-info :status unsat)
(declare-fun a (Bool) Bool)
(declare-fun b (Bool) Bool)
(declare-fun c (Bool) Bool)
(declare-fun d () Bool)
(declare-fun e () Bool)
(declare-fun f () Bool)
(assert (distinct (a d) (a e)))
(assert (distinct (b e) (b f)))
(assert (distinct (c f) (c d)))
(check-sat)
