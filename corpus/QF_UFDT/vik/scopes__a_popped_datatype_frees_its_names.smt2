; Hand-written for VIK (this repository's license): a datatype declared inside a level goes with the
; level's `pop`, and its name is free for an uninterpreted sort, its constructors' and selectors' names
; for symbols of that sort (issue 144). The solver's encoder, built at the first check, kept the
; datatype when no other datatype was declared after the pop: it held the constants of the new sort to
; the datatype's two values, the constants named like its constructors to be distinct, and the function
; named like a selector to read the field of the one named like its constructor, and answered unsat on
; each of the sat checks that follow a `pop`. Each group sits inside a level of its own, whose
; assertions must stay in force after the inner `pop`, as the group's last check tells.
(set-logic ALL)
(push 1)
(push 1)
(declare-datatype D ((A) (B)))
(declare-const w D)
(set-info :status sat)
(check-sat)
(pop 1)
(declare-sort D 0)
(declare-const x D)
(declare-const y D)
(declare-const z D)
(assert (distinct x y z))
(set-info :status sat)
(check-sat)
(declare-const A D)
(declare-const B D)
(assert (= A B))
(set-info :status sat)
(check-sat)
(assert (= A x))
(assert (= B y))
(set-info :status unsat)
(check-sat)
(pop 1)
(declare-const n Int)
(push 1)
(assert (> n 0))
(push 1)
(declare-datatype P ((mk (fst Int))))
(declare-const p P)
(assert (= (fst p) n))
(set-info :status sat)
(check-sat)
(pop 1)
(declare-sort P 0)
(declare-fun mk (Int) P)
(declare-fun fst (P) Int)
(assert (= (mk 1) (mk 2)))
(assert (distinct (fst (mk n)) n))
(set-info :status sat)
(check-sat)
(assert (< n 0))
(set-info :status unsat)
(check-sat)
(pop 1)
