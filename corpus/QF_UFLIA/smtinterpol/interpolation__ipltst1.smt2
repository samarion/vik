; From smtinterpol: interpolation/ipltst1.smt2 (LGPL-3.0, LICENSES/smtinterpol.txt)
; statuses: the `unknown` ones answered by Z3 version 4.14.0 (statusstamp, 2026-11-17; its `set-option` and `get-` commands left out, z3 refusing SMTInterpol's options)
(set-option :produce-interpolants true)
(set-option :interpolant-check-mode true)
(set-logic QF_UFLIA)
(declare-fun f (Int) Int)
(declare-fun b () Int)
(assert (! (= (f b) 0) :named root))
(assert (! (= 0 b) :named left))
(assert (! (= b 1) :named right))
(set-info :status unsat)
(check-sat)
(get-interpolants left (right) root)
