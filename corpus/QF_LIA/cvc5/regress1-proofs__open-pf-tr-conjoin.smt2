; From cvc5: regress1/proofs/open-pf-tr-conjoin.smt2 (modified BSD, LICENSES/cvc5.txt)
; EXPECT: unsat
; logic: QF_LIA, the smallest the script fits, for ALL (prune logic)
(set-logic QF_LIA)
(declare-const x Bool)
(declare-fun a () Int)
(declare-fun b () Int)
(declare-fun c () Int)
(assert (and x (= c (ite (= c 0) 1 0)) (= x (and (distinct b 1) (distinct a 1)))))
(assert (= 1 (ite (= c 0) 1 0)))
(set-info :status unsat)
(check-sat)
