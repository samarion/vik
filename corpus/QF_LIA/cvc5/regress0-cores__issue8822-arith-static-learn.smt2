; From cvc5: regress0/cores/issue8822-arith-static-learn.smt2 (modified BSD, LICENSES/cvc5.txt)
; logic: QF_LIA, the smallest the script fits, for ALL (prune logic)
(set-logic QF_LIA)
(set-info :status unsat)
(declare-fun a () Int)
(declare-fun b () Bool)
(declare-fun c () Int)
(assert (< a 0))
(assert (< 0 c))
(assert (= a (- (ite (not (= 0 (+ 1 (ite b c 0)))) 1 0) 1)))
(check-sat)
