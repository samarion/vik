; From cvc5: regress0/proofs/issue13091-incremental-scoped-assump.smt2 (modified BSD, LICENSES/cvc5.txt)
; EXPECT: sat
; EXPECT: unsat
; EXPECT: unsat
; logic: QF_LIA, the smallest the script fits, for QF_UFLIA (prune logic)
(set-logic QF_LIA)
(set-option :incremental true)
(declare-fun p () Bool)
(declare-fun q () Bool)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(assert (or (not (< y z)) p))
(assert (or (= y z) (not p)))
(assert (< x z))
(assert (or (= y x) q))
(set-info :status sat)
(check-sat)
(push 1)
(assert (< y z))
(set-info :status unsat)
(check-sat)
(pop 1)
(assert (not q))
(set-info :status unsat)
(check-sat)
