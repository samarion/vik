; Hand-written for VIK (this repository's license): constructors of an infinite datatype over a field of a
; finite sort. A tester that holds expands its term into the constructor over the term's selector
; applications, and those got their own tester disjunction, or a truth value, only under a finite datatype:
; here no term of the script names them, so two `of-Unit` values stayed apart, against the one value of
; `Unit`, and so did three `of-Bool` and four `of-Opt` values (issue 125, 2026-11-17).
(set-logic ALL)
(declare-datatypes ((Unit 0) (Opt 0) (Val 0))
  (((unit))
   ((none) (some (get Bool)))
   ((of-Int (to-Int Int)) (of-Unit (to-Unit Unit)) (of-Bool (to-Bool Bool)) (of-Opt (to-Opt Opt)))))
(declare-datatypes ((L 0)) (((nil) (cons (hd Unit) (tl L)))))
(declare-const x Val)
(declare-const y Val)
(declare-const z Val)
(declare-const w Val)
(push 1)
(assert ((_ is of-Unit) x))
(assert ((_ is of-Unit) y))
(assert (not (= x y)))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert ((_ is of-Bool) x))
(assert ((_ is of-Bool) y))
(assert (distinct x y))
(set-info :status sat)
(check-sat)
(assert ((_ is of-Bool) z))
(assert (distinct x y z))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert ((_ is of-Opt) x))
(assert ((_ is of-Opt) y))
(assert ((_ is of-Opt) z))
(assert (distinct x y z))
(set-info :status sat)
(check-sat)
(assert ((_ is of-Opt) w))
(assert (distinct x y z w))
(set-info :status unsat)
(check-sat)
(pop 1)
(declare-const l L)
(declare-const m L)
(assert ((_ is cons) l))
(assert ((_ is cons) m))
(assert (= (tl l) (tl m)))
(assert (not (= l m)))
(set-info :status unsat)
(check-sat)
