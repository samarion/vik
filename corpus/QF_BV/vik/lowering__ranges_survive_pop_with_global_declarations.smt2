; Hand-written for VIK (this repository's license): under `:global-declarations` a bit-vector constant
; declared inside a level keeps its range after the level's `pop` (issue 145). The range is an assertion
; of the lowering, made at the level of the declaration, and it went with the level while the
; declaration stayed: the constant was an integer of any size afterwards, and VIK answered sat on each
; of the unsat checks below. Through one `pop`, through two levels popped at once, and level by level
; with a check at each level on the way down.
(set-logic QF_BV)
(set-option :global-declarations true)
(push 1)
(declare-const x (_ BitVec 1))
(pop 1)
(push 1)
(assert (bvugt x #b1))
(set-info :status unsat)
(check-sat)
(pop 1)
(assert (bvuge x #b1))
(set-info :status sat)
(check-sat)
(push 2)
(declare-const y (_ BitVec 8))
(declare-const z (_ BitVec 8))
(assert (= z (bvadd y #x01)))
(set-info :status sat)
(check-sat)
(pop 2)
(push 1)
(assert (bvult y z))
(set-info :status sat)
(check-sat)
(assert (bvuge y #xff))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(push 1)
(declare-const w (_ BitVec 4))
(assert (bvugt w #x7))
(set-info :status sat)
(check-sat)
(pop 1)
(push 1)
(assert (bvugt w #xf))
(set-info :status unsat)
(check-sat)
(pop 1)
(pop 1)
(assert (bvuge w #x8))
(set-info :status sat)
(check-sat)
(assert (bvult (bvashr w #x1) #x8))
(set-info :status unsat)
(check-sat)
