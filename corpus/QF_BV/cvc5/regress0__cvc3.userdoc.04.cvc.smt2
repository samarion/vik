; From cvc5: regress0/cvc3.userdoc.04.cvc.smt2 (modified BSD, LICENSES/cvc5.txt)
; EXPECT: unsat
; logic: QF_BV, the smallest the script fits, for ALL (prune logic)
(set-logic QF_BV)
(set-option :incremental false)
(declare-fun x () (_ BitVec 1024))
(declare-fun y () (_ BitVec 1024))
(declare-fun z () (_ BitVec 1024))
(declare-fun t () (_ BitVec 1024))
(declare-fun q () (_ BitVec 1024))
(assert (= x (bvnot x)))
(assert (= (bvand (bvand (bvand (bvand x y) t) z) q) x))
(assert (= (bvor x y) t))
(assert (= (bvxor x (bvnot x)) t))
(set-info :status unsat)
(check-sat)
