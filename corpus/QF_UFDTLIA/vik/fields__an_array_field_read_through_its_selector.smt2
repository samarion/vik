; Hand-written for VIK (this repository's license): an array field read through its selector. The
; selector's application is the array the constructor was given, so a read of one is a read of the
; other, also at two indices that arithmetic makes equal, under a second datatype and for an array of
; arrays. The selector's applications met their constructor's arguments only for integer and real
; fields, so the two arrays were never a pair, their reads were not shared with the arithmetic solver,
; and each unsat check answered sat (issue 134).
(set-logic ALL)
(declare-datatype D ((C (n Int) (arr (Array Int Int))) (E)))
(declare-datatype W ((mk (d D))))
(declare-datatype M ((mm (rows (Array Int (Array Int Int))))))
(declare-const a (Array Int Int))
(declare-const b (Array Int Int))
(declare-const m (Array Int (Array Int Int)))
(declare-const x D)
(declare-const w W)
(declare-const i Int)
(declare-const j Int)
(push 1)
(assert (not (= (select (arr (C 0 a)) 0) (select a 0))))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (not (= (select (arr (C 0 a)) 0) (select b 0))))
(set-info :status sat)
(check-sat)
(pop 1)
(push 1)
(assert (= x (C i a)))
(assert (<= i j))
(assert (<= j i))
(assert (< (select (arr x) i) (select a j)))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (= w (mk (C 3 a))))
(assert (> (select (arr (d w)) 2) (select a 2)))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (not (= (select (select (rows (mm m)) 0) 1) (select (select m 0) 1))))
(set-info :status unsat)
(check-sat)
(pop 1)
