; From cvc5: regress0/proofs/subtype-elim-2.smt2 (modified BSD, LICENSES/cvc5.txt)
; EXPECT: unsat
; logic: QF_LRA, the smallest the script fits, for LRA (prune logic)
(set-option :simplification none)
(set-logic QF_LRA)
(declare-const a Real)
(declare-const b Real)
(declare-const c Real)
(assert (< (- (+ a b) c) 3.0))
(assert (< c (- 10.0)))
(assert (< 5.0 b))
(assert (< 0.0 a))
(assert (not false))
(set-info :status unsat)
(check-sat)
