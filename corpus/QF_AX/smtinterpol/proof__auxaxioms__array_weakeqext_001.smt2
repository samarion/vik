; From smtinterpol: proof/auxaxioms/array_weakeqext_001.smt2 (LGPL-3.0, LICENSES/smtinterpol.txt)
; logic: QF_AX, the smallest the script fits, for QF_AUFLIA (prune logic)
; statuses: the `unknown` ones answered by Z3 version 4.14.0 (statusstamp, 2026-11-17; its `set-option` and `get-` commands left out, z3 refusing SMTInterpol's options)
(set-option :produce-proofs true)
(set-option :proof-check-mode true)
(set-option :interactive-mode true)

(set-logic QF_AX)
(declare-sort U 0)
(declare-fun i1 () U)
(declare-fun i2 () U)
(declare-fun i3 () U)
(declare-fun v1 () U)
(declare-fun v2 () U)
(declare-fun v3 () U)
(declare-fun a () (Array U U))
(declare-fun b () (Array U U))
(declare-fun c () (Array U U))
(declare-fun d () (Array U U))
(assert (= b (store a i1 v1)))
(assert (= c (store b i2 v2)))
(assert (= d (store c i3 v3)))
(assert (= (select a i1) (select d i1)))
(assert (= (select a i2) (select d i2)))
(assert (= (select a i3) (select d i3)))
(assert (not (= a d)))
(set-info :status unsat)
(check-sat)
(set-option :print-terms-cse false)
(get-proof)
