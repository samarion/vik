(set-option :produce-interpolants true)
(set-option :interpolant-check-mode true)
(set-logic QF_AUFLIA)
(declare-sort U 0)
(declare-const ar1 (Array Int Int))
(declare-const ar2 (Array Int Int))
(declare-const ar (Array Int Int))
(declare-const s Int)
(declare-const t U)
(declare-const t2 U)
(declare-const a Int)
(declare-const b Int)
(declare-fun f (U) Int)

(assert (! (= ar1 (store ar2 (+ s (* 2 a)) 0)) :named A))
(assert (! (not (= (select ar1 (+ s (* 2 b) 1)) (select ar2 (+ s (* 2 b) 1)))) :named B))
(set-info :status unsat)
(check-sat)
(get-proof)
(get-interpolants A B)
