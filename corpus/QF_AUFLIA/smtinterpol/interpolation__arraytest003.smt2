; From smtinterpol: interpolation/arraytest003.smt2 (LGPL-3.0, LICENSES/smtinterpol.txt)
; statuses: the `unknown` ones answered by Z3 version 4.14.0 (statusstamp, 2026-11-17; its `set-option` and `get-` commands left out, z3 refusing SMTInterpol's options)
(set-option :produce-proofs true)
(set-option :interpolant-check-mode true)

(set-logic QF_AUFLIA)
(declare-fun i () Int)
(declare-fun j () Int)
(declare-fun k1 () Int)
(declare-fun k2 () Int)
(declare-fun v1 () Int)
(declare-fun v2 () Int)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun a () (Array Int Int))
(declare-fun b () (Array Int Int))
(declare-fun s1 () (Array Int Int))
(declare-fun s2 () (Array Int Int))
(declare-fun s3 () (Array Int Int))

(assert (! (and (< (select a i) y) (and (= i x) (and (= a (store s1 k1 v1))
(and (not (= i k1)) (and (= s3 (store s2 k2 v2)) (and (not (= i k2))
(not (= v1 v2)))))))) :named A))
(assert (! (and (= s1 s2) (and (= s3 b)
(and (= x j) (< y (select b j))))) :named B))

(set-info :status unsat)
(check-sat)
(set-option :print-terms-cse false)
(get-proof)
(get-interpolants A B)
(exit)
