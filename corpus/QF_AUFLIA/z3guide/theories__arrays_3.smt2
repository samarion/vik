; From z3guide: 02 - theories/04 - Arrays.md (block 3) (MIT, LICENSES/z3guide.txt)
; logic: QF_AUFLIA, the smallest the script fits, which set none (prune logic)
; statuses: the `unknown` ones answered by Z3 version 4.15.1 (statusstamp, 2026-11-18)
(set-logic QF_AUFLIA)
(declare-const all1 (Array Int Int))
(declare-const a Int)
(declare-const i Int)
(assert (= all1 ((as const (Array Int Int)) 1)))
(assert (= a (select all1 i)))
(set-info :status sat)
(check-sat)
(get-model)
(assert (not (= a 1)))
(set-info :status unsat)
(check-sat)
